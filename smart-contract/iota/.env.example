IOTA_NETWORK=testnet
IOTA_RPC_URL=https://api.testnet.iota.cafe
IOTA_NOTARIZATION_PKG_ID=
# Leave empty to generate an ephemeral account and request faucet funding.
IOTA_PRIVATE_KEY=
IOTA_REQUEST_FAUCET=1
IOTA_LOCK_SECONDS=120
IOTA_WAIT_FOR_UNLOCK=1
# Parallel writes can contend for the same gas coin. Use a disposable account.
IOTA_TEST_PARALLEL=1
